{
  "name": "chamiko-brief",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/prepare-brief.mjs",
    "build": "next build",
    "prebuild": "node scripts/prepare-brief.mjs && node scripts/clean-out.mjs",
    "postbuild": "node scripts/check-export.mjs",
    "prepare-brief": "node scripts/prepare-brief.mjs",
    "times": "node scripts/prepare-brief.mjs --times-only",
    "hooks:install": "git config core.hooksPath .githooks",
